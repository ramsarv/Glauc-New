# ══════════════════════════════════════════════════════════════
# Glauc — Environment Variables
# Copy this file to .env and fill in all values before running.
# ══════════════════════════════════════════════════════════════

# ── Node.js Gateway ──────────────────────────────────────────
# Required: random 64-char hex string. Generate: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_string

# Required: shared HMAC secret between Node gateway and Python API
GATEWAY_SECRET=replace_with_another_64_char_hex_string

# Python model API URL (must be running on a GPU server)
PYTHON_API_URL=http://localhost:8000

# URL origin of the Python API (used for CORS in glauc_api.py)
GATEWAY_ORIGIN=http://localhost:3000

# Gateway port
PORT=3000
NODE_ENV=development

# Scans allowed per user per day
MAX_SCANS_DAY=10

# Allowed CORS origins (comma-separated, production only)
# CORS_ORIGINS=https://app.glauc.io,https://glauc.io

# ── OAuth ─────────────────────────────────────────────────────
# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Sign In — configure at developer.apple.com
APPLE_CLIENT_ID=com.glauc.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Path to your Apple private key .p8 file
APPLE_PRIVATE_KEY_PATH=./AuthKey_KEYID.p8

# ── Expo App (EXPO_PUBLIC_ prefix exposes to client) ─────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
# iOS only — from GoogleService-Info.plist (REVERSED_CLIENT_ID)
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID

# ── Stripe ────────────────────────────────────────────────────
# Create at dashboard.stripe.com → Developers → API keys
# Publishable key (safe to expose in app — starts with pk_)
EXPO_PUBLIC_STRIPE_KEY=pk_test_your_publishable_key

# Secret key — SERVER ONLY, never expose in app (starts with sk_)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Webhook signing secret — from Stripe Dashboard → Webhooks → Signing secret
# Set up webhook endpoint: POST https://your-api.com/webhook/stripe
# Listen for: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ── Python API (set in your GPU server environment) ───────────
# GATEWAY_SECRET (same as above — must match)
# GATEWAY_ORIGIN (URL of your Node gateway)
# DISABLE_DOCS=1  (disables /docs and /redoc in production)
